{
  "name": "pi-edit-modes",
  "version": "0.2.7",
  "description": "Model-aware Pi file editing modes aligned with Codex, Gemini CLI, and DeepSeek Harness tool surfaces.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "fetch-vendors": "node scripts/fetch-vendors.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings src tests",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepack": "pnpm check"
  },
  "files": [
    "dist",
    "docs",
    "scripts/fetch-vendors.mjs",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "ignore": "^7.0.8",
    "koffi": "^3.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^26.4.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "typebox": "*",
    "typescript": "7.0.2"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "packageManager": "pnpm@12.3.4"
}
